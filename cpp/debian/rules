#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake --builddirectory=build-debian

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake --builddirectory=build-debian -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) \
		-DBUILD_SHARED_LIBS=ON \
		-DBUILD_MAVSDK_SERVER=OFF \
		-DSUPERBUILD=ON \
		-DMAVSDK_USE_SYSTEM_COMMON_DEPENDENCIES=ON \
		-DBUILD_TESTING=OFF \
		-DWERROR=OFF \
		-DMAVSDK_VERSION=$(DEB_VERSION_UPSTREAM)

override_dh_missing:
	dh_missing --fail-missing
