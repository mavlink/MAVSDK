void GrpcServer::setup_port(grpc::ServerBuilder& builder)
{
    builder.AddListeningPort(
        listen_address(_port), grpc::InsecureServerCredentials(), &_bound_port);
}

std::string GrpcServer::listen_address(const int port) const
{
    // IPv6 literals need brackets to be told apart from the port.
    const bool is_bare_ipv6 =
        _bind_address.find(':') != std::string::npos && _bind_address.front() != '[';

    return (is_bare_ipv6 ? "[" + _bind_address + "]" : _bind_address) + ":" + std::to_string(port);
}

